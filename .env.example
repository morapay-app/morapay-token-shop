# Server-only Morapay API base (never NEXT_PUBLIC_)
MORAPAY_API_BASE=https://api.morapay.io

# Shop identity — sent in analytics / attribution
SHOP_ID=theafricanmeme

# Canonical public URL (OG, sitemap, absolute links)
NEXT_PUBLIC_SITE_URL=https://token-shop-production-ecd0135d.up.railway.app

# Overrides config.attribution.referralCode when set (format MP-XXXXXX)
# TODO(owner): issue one per shop
MORAPAY_REFERRAL_CODE=

# Future partner / merchant signing (never expose to browser)
# TODO(owner): required only if Morapay mandates signed partner calls
MORAPAY_PARTNER_KEY=
MORAPAY_PARTNER_SECRET=

# Turnstile — TODO(owner): does Morapay require a token from partner domains?
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Upstash Redis for distributed rate limits (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Kill switch: Telegram-desk-only mode
FORCE_FALLBACK=false
