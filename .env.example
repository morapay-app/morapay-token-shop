# --- Morapay Merchant API (server-only; never NEXT_PUBLIC_) ---
MORAPAY_API_BASE=https://api.morapay.io
MORAPAY_MERCHANT_PUBLIC_KEY=pk_test_your_public_key
MORAPAY_MERCHANT_SECRET_KEY=sk_test_your_secret_key
# Must match your key pair: test | live
MORAPAY_ENV=test

# Optional: legacy unsigned public API (off by default — do not use in production)
# MORAPAY_ALLOW_PUBLIC_FALLBACK=false

# Shop identity — analytics / attribution
SHOP_ID=yourtoken

# Canonical public URL (OG, sitemap, absolute links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Overrides config.attribution.referralCode when set (format MP-XXXXXX)
MORAPAY_REFERRAL_CODE=

# Trust Cloudflare client IP headers on Workers/Pages
# TRUST_CLOUDFLARE_IP=true

# Turnstile (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Upstash Redis for distributed rate limits (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Kill switch: Telegram-desk-only mode (still requires merchant keys for health)
FORCE_FALLBACK=false